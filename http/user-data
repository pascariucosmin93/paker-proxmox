#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  network:
    network:
      version: 2
      ethernets:
        ens18:
          dhcp4: true

  storage:
    layout:
      name: lvm

  identity:
    hostname: ubuntu-template
    username: cosmin
    password: "!"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJvSANRk+ESYjW5L8b5hLS3hQLyoetzYNKGkttAore2g packer-build"

  packages:
    - qemu-guest-agent
    - curl
    - wget

  user-data:
    users:
      - name: cosmin
        groups: sudo
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL

  late-commands:
    - curtin in-target -- systemctl enable qemu-guest-agent
    - curtin in-target -- systemctl start qemu-guest-agent
    - "echo 'cosmin ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/cosmin"
    - chmod 440 /target/etc/sudoers.d/cosmin
