#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8

  keyboard:
    layout: us

  network:
    version: 2
    ethernets:
      uplink:
        match:
          name: "en*"
        dhcp4: true

  storage:
    layout:
      name: lvm

  identity:
    hostname: ubuntu-template
    username: cosmin
    password: "$6$SvmZL971xoRtmrwC$SaFgrc43WPb7rWPGaq6F4PKYmG7PHDvEH0vr7Ufpj.eU.xTyDQ8nzNXTko7Y18ZFG/0FgyQg3K.6HD0qgg5fy/"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${ssh_public_key}"

  packages:
    - qemu-guest-agent
    - curl
    - wget
    - openssh-server

  late-commands:
    - curtin in-target -- systemctl enable qemu-guest-agent
    - curtin in-target -- systemctl start qemu-guest-agent
    - "echo 'cosmin ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/cosmin"
    - chmod 440 /target/etc/sudoers.d/cosmin
